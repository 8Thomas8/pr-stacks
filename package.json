{
  "name": "pr-stacks",
  "productName": "PR Stacks",
  "desktopName": "pr-stacks.desktop",
  "version": "0.3.0",
  "description": "Desktop dashboard of stacked GitHub pull requests, powered by the gh CLI.",
  "author": "Thomas Rousseau <thomas.rousseau1@gmail.com>",
  "homepage": "https://github.com/8Thomas8/pr-stacks",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "electron/main.mjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "nuxt build",
    "start": "node scripts/start.mjs",
    "start:build": "node scripts/start.mjs --build",
    "dist": "nuxt build && electron-builder --publish never",
    "icons": "electron scripts/icons.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "nuxt typecheck",
    "check:locales": "node scripts/check-locales.mjs",
    "postinstall": "nuxt prepare"
  },
  "devDependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/schibsted-grotesk": "^5.3.0",
    "@nuxt/eslint": "^1.17.0",
    "@nuxtjs/i18n": "^10.6.0",
    "@types/node": "^24.19.2",
    "dompurify": "^3.4.17",
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3",
    "eslint": "^10.12.0",
    "marked": "^18.1.1",
    "nuxt": "^4.6.1",
    "reka-ui": "^2.11.0",
    "typescript": "^5.9.3",
    "vue": "^3.5.43",
    "vue-router": "^5.4.0",
    "vue-tsc": "^3.3.13"
  },
  "engines": {
    "node": ">=22.12"
  }
}
